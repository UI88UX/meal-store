{
  "name": "online-store",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predeploy": "vite build && copy public\\404.html dist\\404.html && echo meal-store > dist\\CNAME && type nul > dist\\.nojekyll",
    "deploy": "gh-pages -d dist --dotfiles",
    "clean": "rd /s /q dist && rd /s /q node_modules\\.vite",
    "build": "vite build",
    "postdeploy": "echo 'Wait 2 minutes for GitHub to process the deployment'",
    "full-deploy": "npm run clean && npm install && npm run build && npm run deploy",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@reduxjs/toolkit": "^2.6.1",
    "antd": "^5.24.6",
    "axios": "^1.8.4",
    "leaflet": "^1.9.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-head": "^3.4.2",
    "react-leaflet": "^5.0.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.5.0",
    "ulid": "^2.4.0",
    "vite-plugin-pwa": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "gh-pages": "^6.3.0",
    "globals": "^15.15.0",
    "lighthouse": "^12.5.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "vite": "^6.2.0"
  }
}
